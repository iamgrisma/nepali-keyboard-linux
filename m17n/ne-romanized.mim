;; ne-romanized.mim -- Nepali Unicode Romanized input method (Phonetic / MPP Standard)
;; Officially matched against MPP Nepali Unicode Romanized & TopNepali Typing Engine.

(input-method ne romanized)

(description "Nepali Unicode Romanized layout (Official MPP Phonetic Standard)
Maintained by TopNepali (fonts.topnepali.com)
")

(title "NE")

(map
 (trans
   ;; Number row
   ("`" ?़)
   ("~" ?ऽ)
   ("1" ?१)
   ("!" ?!)
   ("2" ?२)
   ("@" ?@)
   ("3" ?३)
   ("#" ?#)
   ("4" ?४)
   ("$" "रु")
   ("5" ?५)
   ("%" ?%)
   ("6" ?६)
   ("^" ?^)
   ("7" ?७)
   ("&" ?&)
   ("8" ?८)
   ("*" ?*)
   ("9" ?९)
   ("(" ?()
   ("0" ?०)
   (")" ?))
   ("-" ?-)
   ("_" ?_)
   ("=" ?‍)  ;; ZWJ
   ("+" ?‌)  ;; ZWNJ

   ;; Row 2 (QWERTY)
   ("q" ?ट)
   ("Q" ?ठ)
   ("w" ?ौ)
   ("W" ?औ)
   ("e" ?े)
   ("E" ?ै)
   ("r" ?र)
   ("R" ?ृ)
   ("t" ?त)
   ("T" ?थ)
   ("y" ?य)
   ("Y" ?ञ)
   ("u" ?ु)
   ("U" ?ू)
   ("i" ?ि)
   ("I" ?ी)
   ("o" ?ो)
   ("O" ?ओ)
   ("p" ?प)
   ("P" ?फ)
   ("[" ?इ)
   ("{" ?ई)
   ("]" ?ए)
   ("}" ?ऐ)
   ("\\" ?ॐ)
   ("|" ?ः)

   ;; Row 3 (Home row)
   ("a" ?ा)
   ("A" ?आ)
   ("s" ?स)
   ("S" ?श)
   ("d" ?द)
   ("D" ?ध)
   ("f" ?उ)
   ("F" ?ऊ)
   ("g" ?ग)
   ("G" ?घ)
   ("h" ?ह)
   ("H" ?अ)
   ("j" ?ज)
   ("J" ?झ)
   ("k" ?क)
   ("K" ?ख)
   ("l" ?ल)
   ("L" ?॥)
   (";" ?;)
   (":" ?:)
   ("'" ?')
   ("\"" ?\")

   ;; Row 4 (Bottom row)
   ("z" ?ष)
   ("Z" ?ऋ)
   ("x" ?ड)
   ("X" ?ढ)
   ("c" ?च)
   ("C" ?छ)
   ("v" ?व)
   ("V" ?ँ)
   ("b" ?ब)
   ("B" ?भ)
   ("n" ?न)
   ("N" ?ण)
   ("m" ?म)
   ("M" ?ं)
   ("," ?,)
   ("<" ?ङ)
   ("." ?।)
   (">" ?.)
   ("/" ?्)
   ("?" ??)

   ;; Space
   (" " ?\ )

   ;; Auto-normalization ligature collapse rules
   ("अा" "आ")
   ("ाे" "ो")
   ("ाै" "ौ")
   ("अो" "ओ")
   ("अौ" "औ")
 ))

(state
  (init
    (trans)))
