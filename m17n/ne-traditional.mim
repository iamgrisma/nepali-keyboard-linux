;; ne-traditional.mim -- Nepali Unicode Traditional input method (Standard Remington)
;; Officially matched against MPP Nepali Unicode Traditional & TopNepali Typing Engine.
;; Supports single-key conjuncts, dead keys, and auto-ligature normalization.

(input-method ne traditional)

(description "Nepali Unicode Traditional layout (Official Remington Standard)
Maintained by TopNepali (fonts.topnepali.com)
")

(title "ने")

(map
 (trans
   ;; Number row
   ("`" ?ञ)
   ("~" ?॥)
   ("1" ?१)
   ("!" "ज्ञ")
   ("2" ?२)
   ("@" ?ई)
   ("3" ?३)
   ("#" ?घ)
   ("4" ?४)
   ("$" "द्ध")
   ("5" ?५)
   ("%" ?छ)
   ("6" ?६)
   ("^" ?ट)
   ("7" ?७)
   ("&" ?ठ)
   ("8" ?८)
   ("*" ?ड)
   ("9" ?९)
   ("(" ?ढ)
   ("0" ?०)
   (")" ?ण)
   ("-" ?औ)
   ("_" ?ओ)
   ("=" ?‍)  ;; ZWJ
   ("+" ?‌)  ;; ZWNJ

   ;; Row 2 (QWERTY)
   ("q" "त्र")
   ("Q" "त्त")
   ("w" ?ध)
   ("W" "ड्ढ")
   ("e" ?भ)
   ("E" ?ऐ)
   ("r" ?च)
   ("R" "द्ब")
   ("t" ?त)
   ("T" "ट्ट")
   ("y" ?थ)
   ("Y" "ठ्ठ")
   ("u" ?ग)
   ("U" ?ऊ)
   ("i" ?ष)
   ("I" "क्ष")
   ("o" ?य)
   ("O" ?इ)
   ("p" ?उ)
   ("P" ?ए)
   ("[" "र्")
   ("{" ?ृ)
   ("]" ?े)
   ("}" ?ै)
   ("\\" ?्)
   ("|" ?ं)

   ;; Row 3 (Home row)
   ("a" ?ब)
   ("A" ?आ)
   ("s" ?क)
   ("S" "ङ्क")
   ("d" ?म)
   ("D" "ङ्ग")
   ("f" ?ा)
   ("F" ?ँ)
   ("g" ?न)
   ("G" "द्द")
   ("h" ?ज)
   ("H" ?झ)
   ("j" ?व)
   ("J" ?ो)
   ("k" ?प)
   ("K" ?फ)
   ("l" ?ि)
   ("L" ?ी)
   (";" ?स)
   (":" "ट्ठ")
   ("'" ?ु)
   ("\"" ?ू)

   ;; Row 4 (Bottom row)
   ("z" ?श)
   ("Z" "क्क")
   ("x" ?ह)
   ("X" "ह्य")
   ("c" ?अ)
   ("C" ?ऋ)
   ("v" ?ख)
   ("V" ?ॐ)
   ("b" ?द)
   ("B" ?ौ)
   ("n" ?ल)
   ("N" "द्य")
   ("m" ?ः)
   ("M" "ड्ड")
   ("," ?ऽ)
   ("<" ?ङ)
   ("." ?।)
   (">" "श्र")
   ("/" ?र)
   ("?" "रु")

   ;; Space
   (" " ?\ )

   ;; Auto-normalization ligature collapse rules
   ("अा" "आ")
   ("ाे" "ो")
   ("ाै" "ौ")
   ("अो" "ओ")
   ("अौ" "औ")
 ))

(state
  (init
    (trans)))
